    "/api/admin/schemas/import": {
      "post": {
        "description": "Reports what would change. Nothing is written unless apply=true, because the statements a schema change generates include destructive ones.",
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "default": "lyeve",
              "enum": [
                "lyeve",
                "json-schema",
                "openapi",
                "strapi",
                "contentful",
                "wordpress"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "apply",
            "required": false,
            "schema": {
              "default": false,
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "409": {
            "description": "References cannot be satisfied; nothing was applied"
          },
          "422": {
            "description": "Definitions could not be read"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "cookieAuth": []
          }
        ],
        "summary": "Import content types from a bundle or another system",
        "tags": [
          "Admin / Content Types"
        ]
      }
    },
