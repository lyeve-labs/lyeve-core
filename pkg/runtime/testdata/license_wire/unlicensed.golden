        ]
      }
    },
    "/api/admin/setup": {
      "get": {
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "summary": "Check setup status",
        "tags": [
          "Admin / Auth"
        ]
      },
      "post": {
        "description": "Requires the setup token: LYEVE_SETUP_TOKEN, or the one-time token the engine logs at boot while no account exists. Send it as `setup_token` or in the `X-Setup-Token` header. Answers 409 once an account exists.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "example": {
                  "email": "admin@example.com",
                  "password": "changeme",
                  "setup_token": "from-the-engine-log"
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "OK"
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "409": {
            "description": "Setup already complete"
          }
        },
        "summary": "Initial admin setup (first-run only)",
        "tags": [
          "Admin / Auth"
        ]
      }
    },
