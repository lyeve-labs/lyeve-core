    "/api/admin/debug/goroutines": {
      "get": {
        "description": "The tracker snapshot: tracked and runtime totals, counts by source name, and by_owner, one row per plugin or the engine with its live count and the age of its oldest goroutine, so a leak names who started it.",
        "responses": {
