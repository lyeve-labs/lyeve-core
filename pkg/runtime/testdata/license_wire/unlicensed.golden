    "/api/v1/content/{schema}": {
      "get": {
        "parameters": [
          {
            "description": "Collection name, as listed by GET /api/v1/schemas.",
            "in": "path",
            "name": "schema",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Maximum records per page. Clamped to 1-200 (default 25). Values above 200 are silently reduced to 200 and bypass the list cache. For traversing large result sets, use the cursor endpoint instead.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 25,
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "type": "integer"
            }
          },
          {
            "description": "Relation fields to resolve inline, comma-separated, or * for all.",
            "in": "query",
            "name": "populate",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "How many levels of relations to resolve.",
            "in": "query",
            "name": "depth",
            "required": false,
            "schema": {
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "The locale to serve the record's fields in, a language tag such as fr or pt-BR. Without it the Accept-Language header's preferred language is used. Honored only when a localizer is registered: each record's fields are then merged with its translation and the record carries resolved_locale, the locale the fields came from after the tenant's fallback chain. Otherwise the parameter is ignored and the response is unchanged.",
            "in": "query",
            "name": "locale",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          },
          "503": {
            "description": "The translations could not be read"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List records",
        "tags": [
          "Content API / Content"
        ]
      },
      "post": {
        "parameters": [
          {
            "description": "Collection name, as listed by GET /api/v1/schemas.",
            "in": "path",
            "name": "schema",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "Hook validation failed"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Create a record",
        "tags": [
          "Content API / Content"
        ],
        "x-roles": [
          "editor",
          "admin",
          "super_admin"
        ]
      }
    },
