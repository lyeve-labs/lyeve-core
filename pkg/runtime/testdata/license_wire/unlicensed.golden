        ]
      }
    },
    "/api/admin/auth/mfa-verify": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "example": {
                  "challenge_token": "\u003cshort-lived JWT\u003e",
