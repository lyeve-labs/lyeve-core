=== openapi as an admin
GET /api/admin/openapi.json as admin
status: 200
Cache-Control: no-store
Content-Type: application/json
body (json, newline):
{
  "components": {
    "securitySchemes": {
      "adminToken": {
        "bearerFormat": "lyat",
        "description": "An admin token, sent as Authorization: Bearer lyat_<secret>. It reaches only the admin operations whose x-admin-grant it holds, in the one tenant it was issued for.",
        "scheme": "bearer",
        "type": "http"
      },
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "cookieAuth": {
        "description": "Session cookie set at sign-in. A server running without secure cookies names it sys_session.",
        "in": "cookie",
        "name": "__Host-sys_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "The content API, auth, and every route outside /api/admin.",
    "title": "LyEve API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/.well-known/jwks.json": {
      "get": {
        "description": "Verify a token the engine issued without calling it: every key the engine signs with, current and rotated, by kid.",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "summary": "The signing keys, as a JWK Set",
        "tags": [
          "Content API / Auth"
        ]
      }
    },
    "/api/v1/auth/token": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "example": {
                  "email": "user@example.com",
                  "password": "changeme"
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "summary": "Obtain a Bearer token",
        "tags": [
          "Content API / Auth"
        ]
      }
    },
