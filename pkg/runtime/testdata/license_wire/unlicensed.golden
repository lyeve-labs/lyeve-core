=== plugin status
GET /api/admin/plugins/status as super admin
status: 200
Cache-Control: no-store
Content-Type: application/json
body (json, newline):
{
  "compiled": [
    "gadgets",
    "widgets"
  ],
  "entitled": [
    "gadgets",
    "widgets"
  ],
  "plugins": [
    {
      "active": true,
      "compiled": true,
      "entitled": true,
      "name": "gadgets",
      "phase": "running",
      "requested": true,
      "routes": [
        {
          "group": "admin",
          "method": "GET",
          "pattern": "/api/admin/wire/gadgets"
        }
      ],
      "started_at": "<time>"
    },
    {
      "active": true,
      "compiled": true,
      "entitled": true,
      "name": "widgets",
      "phase": "running",
      "requested": true,
      "routes": [
        {
          "group": "admin",
          "method": "GET",
          "pattern": "/api/admin/wire/widgets"
        }
      ],
      "started_at": "<time>"
    }
  ]
}

