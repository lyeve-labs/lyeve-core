        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "Invalid code"
          }
        },
        "summary": "Complete MFA challenge - exchange challenge token + TOTP code for a full session JWT",
        "tags": [
          "Admin / Auth"
        ]
      }
    },
    "/api/admin/auth/refresh": {
      "post": {
        "description": "Rotates the refresh token and issues a new access token. Rate limited.",
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "summary": "Refresh the session",
        "tags": [
          "Admin / Auth"
        ]
      }
    },
    "/api/admin/config": {
      "get": {
        "responses": {
          "200": {
            "description": "OK"
          },
