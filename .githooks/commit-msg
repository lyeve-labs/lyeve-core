#!/usr/bin/env bash
msg=$(head -1 "$1")
case "$msg" in Merge*|Revert*|"fixup!"*|"squash!"*) exit 0 ;; esac
re="^(feat|fix|perf|refactor|docs|test|build|ci|chore|style)(\([a-z0-9._-]+\))?(!)?: .+"
if [[ ! "$msg" =~ $re ]]; then
  echo "commit message must follow Conventional Commits: type(scope): summary" >&2
  exit 1
fi
exit 0
